# Example environment variables for FaraX.
#
# Copy this file to `.env` (git-ignored) and fill in real values. FaraX doesn't read
# `.env` itself: export the variables in your shell, or let Docker Compose load the file
# (the values below work as they are for Docker Compose).
# With none of these set, FaraX uses SQLite in the git-ignored `db/` directory.

# PostgreSQL. Setting POSTGRES_DB switches the database from SQLite to PostgreSQL.
# Name of the database. The test suite creates and drops a separate `test_<name>`.
POSTGRES_DB=farax
# User and password to connect as (default: empty, i.e. libpq defaults).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Server address (default: localhost) and port (default: 5432). Docker Compose ignores
# these and connects to its own `postgres` service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Directory of the File Store, where Raw Files are kept (default: the git-ignored `media/`
# directory). Docker Compose sets this to a named volume.
# DJANGO_MEDIA_ROOT=/path/to/file-store

# Largest schema file, in bytes, that can be uploaded to register a schema (default:
# 512000). Must be a positive whole number; Django refuses to start otherwise.
# DJANGO_SCHEMA_UPLOAD_MAX_BYTES=512000

# Production only (DJANGO_SETTINGS_MODULE=farax.settings.production). The production
# settings require these and all of the POSTGRES_* variables above, with no defaults.
# Secret key: a long random string, for example from
# `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
# DJANGO_SECRET_KEY=change-me
# Comma-separated host names the site is served from.
# DJANGO_ALLOWED_HOSTS=farax.example.com
# Email is sent over SMTP. These are optional; empty values count as unset.
# SMTP server (default: localhost) and port (default: 587 with TLS, otherwise 25).
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# Credentials to log in to the SMTP server with (default: don't log in).
# DJANGO_EMAIL_HOST_USER=farax@example.com
# DJANGO_EMAIL_HOST_PASSWORD=change-me
# Use STARTTLS: true or false (default: false).
# DJANGO_EMAIL_USE_TLS=true
